{
  "name": "amigo-secreto-import",
  "main": "index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "browser": {
    "binding": "BROWSER"
  },
  "ratelimits": [
    {
      "name": "SCREENSHOT_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "SCREENSHOT_GLOBAL_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
